POSTGRES_USER=meetings
POSTGRES_PASSWORD=meetings
POSTGRES_DB=meetings
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
SEED=true
# Host ports (change if already taken on your machine)
DB_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000
# Cognito: `make aws-cognito-deploy` (or `make aws-cognito-env`) prints these values. Empty = auth disabled locally: no sign-in is
# checked and every request acts as one local user.
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
# Google sign-in (required by `make aws-cognito-deploy`): create an OAuth client in Google Cloud
# (`make aws-cognito-google` prints its origin and redirect URI). The secret stays here, never in git.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# AWS deployment (`make aws-deploy`, always to us-east-1). .env is gitignored — never commit real keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# CloudFront pricing: FREE (flat-rate Free plan, max 3 per account) or PAY_AS_YOU_GO
CLOUDFRONT_PLAN=FREE
# Optional custom domain for the site (e.g. demo.your-domain.com); empty = the CloudFront domain
FRONTEND_DOMAIN=
# Weekly report (`make aws-reports-deploy`): the inbox it is emailed to (SES sends a verification link
# first). Optionally REPORT_DOMAIN=your-domain.com to send as reports@your-domain.com (DKIM records needed).
REPORT_EMAIL=
REPORT_DOMAIN=
